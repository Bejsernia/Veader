{
  "name": "veader",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/start-expo.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/start-expo.cjs --web",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:apk:cloud": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:reader": "jest src/reader --runInBand",
    "test:database": "jest src/data src/domain --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "14.0.3",
    "@react-native-community/slider": "4.5.2",
    "expo": "~51.0.39",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-intent-launcher": "~11.0.1",
    "expo-modules-core": "~1.12.26",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "fast-xml-parser": "^5.10.1",
    "graphql": "^16.8.1",
    "jszip": "^3.10.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-webview": "13.8.6",
    "veader-folder-picker": "file:./modules/veader-folder-picker"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~18.2.79",
    "eas-cli": "^21.7.0",
    "jest-expo": "~51.0.0",
    "typescript": "~5.3.3"
  }
}
